[Unit]
Description=Nanoleaf Control Web Interface
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=nanoleaf
Group=nanoleaf
WorkingDirectory=/opt/nanoleaf
ExecStart=/opt/nanoleaf/venv/bin/nanoleaf-ctl web --port 5000
Environment=HOME=/var/lib/nanoleaf
StateDirectory=nanoleaf
StateDirectoryMode=0700
Restart=always
RestartSec=5
WatchdogSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
